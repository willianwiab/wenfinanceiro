rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function proprietario() {
      return request.auth != null && request.auth.token.email == 'wenprodutora@gmail.com';
    }
    function administrativo() {
      return request.auth != null
        && request.auth.token.email == 'financeiro@wenprodutora.com.br'
        && request.auth.token.email_verified == true;
    }
    // Nenhuma permissão administrativa sobre lançamentos, bancos, despesas ou folha.
    match /{document=**} { allow read, write: if proprietario(); }
    // Ficha cadastral do cliente: o administrativo preenche os DADOS (CNPJ, razão
    // social, contato, e-mail, WhatsApp) porque é ela quem fala com o financeiro do
    // cliente. As DECISÕES do proprietário — exigeNota, cobrancaAdministrativo,
    // condicaoPagamento, notaSinal, fechamentoPadrao, envioPreferido — ficam fora do
    // que ela pode tocar: são os chips do card da diária, no WEN Financeiro.
    match /clientes_fiscais/{id} {
      allow read: if administrativo();
      allow create: if administrativo()
        && request.resource.data.keys().hasOnly([
          'nome','nomes','razaoSocial','doc','contatoFinanceiro','emailFinanceiro',
          'whatsappFinanceiro','emailNota','telefone','responsavel','criadoEm','atualizadoEm'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 150;
      allow update: if administrativo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'razaoSocial','doc','contatoFinanceiro','emailFinanceiro','whatsappFinanceiro',
          'emailNota','telefone','responsavel','atualizadoEm'])
        && request.resource.data.get('doc', '').size() <= 14
        && request.resource.data.get('razaoSocial', '').size() <= 150
        && request.resource.data.get('contatoFinanceiro', '').size() <= 120
        && request.resource.data.get('whatsappFinanceiro', '').size() <= 30
        && request.resource.data.get('emailFinanceiro', '').size() <= 150
        && request.resource.data.get('emailNota', '').size() <= 150;
    }

    // Avisos: ela LÊ e só marca como lido. Nunca cria, nunca apaga, nunca muda o texto.
    // Quem escreve aviso é o proprietário, pelo WEN Financeiro.
    match /administrativo_avisos/{id} {
      allow read: if administrativo();
      allow update: if administrativo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lidoEm'])
        && request.resource.data.lidoEm is string
        && request.resource.data.lidoEm.size() <= 30;
    }
    match /administrativo_fechamentos/{id} {
      allow read: if administrativo();
      // Cliente, valores, diárias e permissões são definidos exclusivamente pelo proprietário.
      allow update: if administrativo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'vencimento','cobrancaStatus','fiscalStatus','nfNumero','nfData',
          'descricaoFiscal','descricaoCobranca','enviadoEm','atualizadoEm',
          // 50/50: quando o cliente pede nota do sinal e nota do saldo separadas.
          // O MODO (notaModo) e os valores continuam só do proprietário — aqui ela
          // registra apenas o que foi emitido em cada parte.
          'nfSinalNumero','nfSinalData','nfSinalStatus',
          'nfSaldoNumero','nfSaldoData','nfSaldoStatus',
          // promessa de pagamento: o que o CLIENTE disse. Não é confirmação de
          // recebimento nem muda o vencimento — só faz a cobrança voltar na data.
          'promessaData','promessaObs',
          // notasEmitidas: cada nota guarda quais diárias cobriu, para uma gravação
          // nunca entrar em duas notas. A lista só cresce, nunca encolhe.
          'notasEmitidas'
        ])
        && request.resource.data.get('notasEmitidas', []).size() <= 60
        && request.resource.data.get('notasEmitidas', []).size()
           >= resource.data.get('notasEmitidas', []).size()
        && request.resource.data.get('promessaObs', '').size() <= 300
        && (request.resource.data.get('promessaData', '') == ''
          || request.resource.data.get('promessaData', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        // itens, valores, vencimento e divergência são do espelho (proprietário):
        // ela não reescreve o que veio do Receber.
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['itens','valor','recebido','saldo','vencimento','notaModo',
                      'cliente','lancamentoIds','divergencia','grupo'])
        && request.resource.data.cobrancaStatus in ['pendente','enviada','pago']
        && request.resource.data.fiscalStatus in ['pendente','emitida','nao_solicitada']
        && request.resource.data.descricaoFiscal is string
        && request.resource.data.descricaoFiscal.size() <= 30000
        && request.resource.data.descricaoCobranca is string
        && request.resource.data.descricaoCobranca.size() > 0
        && request.resource.data.descricaoCobranca.size() <= 30000
        && request.resource.data.nfNumero is string
        && request.resource.data.nfNumero.size() <= 200
        && request.resource.data.nfData is string
        && request.resource.data.nfData.size() <= 10
        && request.resource.data.vencimento is string
        && request.resource.data.vencimento.size() <= 10
        && request.resource.data.enviadoEm is string
        && request.resource.data.enviadoEm.size() <= 30
        && request.resource.data.atualizadoEm is string
        && request.resource.data.atualizadoEm.size() <= 30
        && (request.resource.data.fiscalStatus != 'emitida'
          || request.resource.data.get('notaModo', 'junto') == 'separado'
          || (request.resource.data.nfNumero.size() > 0 && request.resource.data.nfData.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        // cada parte: status válido e, se emitida, número e data de verdade
        && request.resource.data.get('nfSinalStatus', 'pendente') in ['pendente', 'emitida']
        && request.resource.data.get('nfSaldoStatus', 'pendente') in ['pendente', 'emitida']
        && request.resource.data.get('nfSinalNumero', '').size() <= 200
        && request.resource.data.get('nfSaldoNumero', '').size() <= 200
        && (request.resource.data.get('nfSinalStatus', 'pendente') != 'emitida'
          || (request.resource.data.get('nfSinalNumero', '').size() > 0
            && request.resource.data.get('nfSinalData', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (request.resource.data.get('nfSaldoStatus', 'pendente') != 'emitida'
          || (request.resource.data.get('nfSaldoNumero', '').size() > 0
            && request.resource.data.get('nfSaldoData', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        // o modo é do proprietário: o administrativo não pode trocá-lo
        && request.resource.data.get('notaModo', 'junto') == resource.data.get('notaModo', 'junto');
    }
  }
}
